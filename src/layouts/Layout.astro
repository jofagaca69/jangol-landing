---
import '../styles/global.css';
import workSans from '@fontsource-variable/work-sans/files/work-sans-latin-wght-normal.woff2?url';
import spaceGrotesk from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { alternatesFor, asLang, htmlLang, langs, ogLocale, site, type Lang } from '../i18n/routes';
import { t } from '../i18n/ui';
import { graph, organization } from '../lib/schema';
import { ogImagePath } from '../lib/og';

interface Props {
	/** Full document title; pages write it out so the brand position is deliberate. */
	title: string;
	description: string;
	ogType?: 'website' | 'article';
	/** Extra JSON-LD nodes for this page; the Organization is always included. */
	schema?: Record<string, unknown>[];
	noindex?: boolean;
	/** Language versions of this page when they cannot be derived from the route map. */
	alternates?: Partial<Record<Lang, string>>;
	/** The home hero sits under a transparent nav for longer before it turns solid. */
	home?: boolean;
	/** Loads the animation bundle (GSAP and smooth scroll) used by the home hero. */
	motion?: boolean;
}

const { title, description, ogType = 'website', schema = [], noindex = false, home = false, motion = false } = Astro.props;
const lang = asLang(Astro.currentLocale);
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonical = new URL(pathname, site).href;
const alternates = noindex ? undefined : (Astro.props.alternates ?? alternatesFor(pathname));
const ogImage = new URL(ogImagePath(noindex ? '/' : pathname), site).href;
const jsonLd = graph([organization(lang), ...schema]);
---

<!doctype html>
<html lang={htmlLang[lang]}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#1a1a1a" />
		<link rel="preload" href={workSans} as="font" type="font/woff2" crossorigin />
		<link rel="preload" href={spaceGrotesk} as="font" type="font/woff2" crossorigin />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
		{
			alternates &&
				langs.map((l) => alternates[l] && <link rel="alternate" hreflang={htmlLang[l]} href={new URL(alternates[l]!, site).href} />)
		}
		{alternates?.es && <link rel="alternate" hreflang="x-default" href={new URL(alternates.es, site).href} />}
		<meta property="og:site_name" content="Jangol" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={title} />
		<meta property="og:locale" content={ogLocale[lang]} />
		{langs.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={ogLocale[l]} />)}
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={jsonLd} />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body>
		<a href="#contenido" class="skip">{t(lang).skip}</a>
		<Nav home={home} />
		<main id="contenido">
			<slot />
		</main>
		<Footer />
		<script>
			import '../scripts/main.ts';
		</script>
		{
			motion && (
				<script>
					import '../scripts/motion.ts';
				</script>
			)
		}
	</body>
</html>
