---
import Layout from '../../layouts/Layout.astro';
import ResourceList from '../../components/ResourceList.astro';
import { getRecursos } from '../../lib/recursos';

const recursos = await getRecursos();
---

<Layout title="Recursos" description="Guías prácticas para administrar gimnasios y colegios, y para decidir qué software necesita tu negocio.">
	<section class="on-dark bg-tinta pt-32 pb-16 text-crema md:pt-40 md:pb-24">
		<div class="wrap">
			<h1 class="t-display text-[clamp(3.5rem,1.5rem+9vw,9rem)]">Recursos</h1>
			<p class="t-lead measure mt-8 text-crema/80">
				Guías prácticas para administrar gimnasios y colegios. Sirven uses o no nuestro software.
			</p>
		</div>
	</section>
	<section class="py-20 md:py-28">
		<div class="wrap">
			<ResourceList items={recursos} />
		</div>
	</section>
</Layout>
