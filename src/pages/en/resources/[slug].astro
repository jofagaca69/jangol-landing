---
import type { GetStaticPaths } from 'astro';
import { getRecursos, recursoSlug } from '../../../lib/recursos';
import Article from '../../../views/Article.astro';

export const getStaticPaths = (async () =>
	(await getRecursos('en')).map((entry) => ({ params: { slug: recursoSlug(entry) }, props: { entry } }))) satisfies GetStaticPaths;
---

<Article entry={Astro.props.entry} />
