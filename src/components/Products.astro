---
import { products } from '../data/products';
import { GRID, circles, parseSprite } from '../lib/dots';

const sprites = products.map((p) => parseSprite(p.sprite));
const count = Math.max(...sprites.map((s) => s.length));
---

<section id="productos" class="py-24 md:py-36" data-products>
	<div class="wrap">
		<div class="grid gap-8 md:grid-cols-12 md:items-end">
			<h2 class="t-h2 md:col-span-7">Lo que hace cada plataforma</h2>
			<p class="t-lead measure text-tinta/75 md:col-span-5">
				Las dos comparten la misma base: cuentas, pagos, permisos y soporte. Cambian los módulos que necesita cada negocio.
			</p>
		</div>

		<div class="mt-12 flex gap-2" role="tablist" aria-label="Plataformas">
			{
				products.map((p, i) => (
					<button
						type="button"
						role="tab"
						id={`tab-${p.id}`}
						aria-controls={`panel-${p.id}`}
						aria-selected={i === 0 ? 'true' : 'false'}
						tabindex={i === 0 ? 0 : -1}
						class="btn border border-tinta/25 whitespace-nowrap max-sm:px-4 max-sm:text-[0.9rem] aria-selected:border-tinta aria-selected:bg-tinta aria-selected:text-crema"
						data-tab={p.id}
					>
						{p.name}
					</button>
				))
			}
		</div>

		<div class="mt-8 grid gap-6 md:grid-cols-12 md:gap-10">
			<div
				class="relative flex aspect-square flex-col justify-end overflow-hidden rounded-[2rem] bg-burdeos p-8 text-crema md:col-span-5 md:aspect-auto md:min-h-[34rem]"
				aria-hidden="true"
				data-showcase
			>
				<svg class="dots absolute inset-[8%] !h-[84%] !w-[84%]" viewBox={`0 0 ${GRID} ${GRID}`} data-showcase-dots set:html={circles(sprites[0], count)} />
			</div>

			<div class="md:col-span-7">
				{
					products.map((p, i) => (
						<div id={`panel-${p.id}`} role="tabpanel" aria-labelledby={`tab-${p.id}`} hidden={i !== 0} data-panel={p.id}>
							<p class="t-h3 measure">{p.tagline}</p>
							<p class="mt-3 text-tinta/70">{p.audience}</p>
							<dl class="mt-10 border-b border-tinta/15">
								{p.moves.map((m) => (
									<div class="grid gap-1 border-t border-tinta/15 py-5 sm:grid-cols-[14rem_1fr] sm:gap-6">
										<dt class="font-display text-[1.08rem] font-semibold">{m.title}</dt>
										<dd class="measure text-tinta/80">{m.desc}</dd>
									</div>
								))}
							</dl>
							<a href="#contacto" class="btn btn-burdeos mt-10" data-demo={p.id}>
								Pedir demo de {p.name}
							</a>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>
