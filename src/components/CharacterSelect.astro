---
import { fighters as roster } from '../data/products';
import { GRID, MONOGRAM, circles, parseSprite } from '../lib/dots';

const monogram = parseSprite(MONOGRAM);
const fighters = roster.map((p, i) => {
	const sprite = parseSprite(p.sprite);
	return { ...p, dots: sprite, count: Math.max(sprite.length, monogram.length), active: i === 0 };
});
---

<section id="top" class="on-dark relative h-[100svh] min-h-[38rem] overflow-hidden bg-tinta text-crema" data-select>
	<h1
		class="absolute top-[4.9rem] left-1/2 z-10 -translate-x-1/2 rounded-full bg-tinta px-5 py-2 font-display text-[clamp(1rem,0.9rem+0.5vw,1.3rem)] font-semibold whitespace-nowrap max-md:hidden"
		data-select-title
	>
		Elige por dónde empezar
	</h1>

	<div class="select" role="radiogroup" aria-label="Elige por dónde empezar">
		{
			fighters.map((f) => (
				<article class="fighter" data-fighter data-id={f.id} aria-current={f.active ? 'true' : 'false'}>
					<div class="fighter-inner">
						<div class="portrait" data-portrait>
							<svg class="cursor" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" data-cursor style={f.active ? '' : 'opacity:0'}>
								<path d="M0 10V0h10M90 0h10v10M100 90v10H90M10 100H0V90" />
							</svg>
							<svg
								class="dots"
								viewBox={`0 0 ${GRID} ${GRID}`}
								aria-hidden="true"
								data-dots
								data-sprite={f.id}
								set:html={circles(f.dots, f.count)}
							/>
						</div>
						<div class="fighter-copy">
							<p class="font-display text-[clamp(1rem,0.85rem+0.6vw,1.5rem)] font-medium opacity-80">{f.label}</p>
							<h2>
								<button
									type="button"
									class="fighter-pick"
									role="radio"
									aria-checked={f.active ? 'true' : 'false'}
									aria-label={f.name}
									tabindex={f.active ? 0 : -1}
									data-pick={f.id}
								>
									<span class="fighter-name t-display block" data-name>{f.short}</span>
								</button>
							</h2>
							<p class="mt-3 max-w-[30ch] lg:mt-5 text-[1rem] leading-snug opacity-85 max-md:hidden md:inline-block" data-tagline>
								{f.tagline}
							</p>
							<ul
								class="moves mt-5 flex max-w-[30rem] flex-wrap gap-x-5 gap-y-1.5 text-[0.92rem]"
								style={f.active ? '' : 'visibility:hidden'}
								data-moves
							>
								{f.moves.map((m) => (
									<li class="font-display font-medium">{m.title}</li>
								))}
							</ul>
						</div>
					</div>
				</article>
			))
		}
	</div>

	<div class="absolute inset-x-0 bottom-0 z-10 flex flex-col items-center gap-3 pb-6">
		<button type="button" class="btn btn-crema shadow-[0_0_0_6px_var(--color-tinta)]" data-confirm>
			<span>Elegir <span data-confirm-name>{fighters[0].name}</span></span>
		</button>
		<p class="rounded-full bg-tinta px-4 py-1 text-[0.85rem] text-crema/80">
			<span class="max-md:hidden">Cambia con ← → o con el cursor.</span>
			<span class="md:hidden">Toca para cambiar.</span>
		</p>
	</div>

	<div class="flash" data-flash></div>
</section>
