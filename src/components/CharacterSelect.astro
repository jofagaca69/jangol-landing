---
import { fighters as rosterFor } from '../data/products';
import { GRID, MONOGRAM, circles, parseSprite } from '../lib/dots';
import { asLang } from '../i18n/routes';
import { t } from '../i18n/ui';

const lang = asLang(Astro.currentLocale);
const copy = {
	es: { group: 'Elige por dónde empezar', choose: 'Elegir', hintDesktop: 'Cambia con ← → o con el cursor.', hintTouch: 'Toca para cambiar.' },
	en: { group: 'Choose where to start', choose: 'Choose', hintDesktop: 'Switch with ← → or the pointer.', hintTouch: 'Tap to switch.' },
}[lang];
const monogram = parseSprite(MONOGRAM);
const fighters = rosterFor(lang).map((p, i) => {
	const sprite = parseSprite(p.sprite);
	return { ...p, dots: sprite, count: Math.max(sprite.length, monogram.length), active: i === 0 };
});
---

<section id="top" class="on-dark relative h-[100svh] min-h-[38rem] overflow-hidden bg-tinta text-crema" data-select>
	<h1
		class="select-title absolute left-1/2 z-10 -translate-x-1/2 rounded-full bg-tinta px-5 py-2 text-center font-display font-semibold"
		data-select-title
	>
		{t(lang).slogan}
	</h1>

	<div class="select" role="radiogroup" aria-label={copy.group}>
		{
			fighters.map((f) => (
				<article class="fighter" data-fighter data-id={f.id} data-href={f.href} data-full-name={f.name} aria-current={f.active ? 'true' : 'false'}>
					<div class="fighter-inner">
						<div class="portrait" data-portrait>
							<svg class="cursor" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true" data-cursor style={f.active ? '' : 'opacity:0'}>
								<path d="M0 10V0h10M90 0h10v10M100 90v10H90M10 100H0V90" />
							</svg>
							<svg
								class="dots"
								viewBox={`0 0 ${GRID} ${GRID}`}
								aria-hidden="true"
								data-dots
								data-sprite={f.id}
								set:html={circles(f.dots, f.count)}
							/>
						</div>
						<div class="fighter-copy">
							<p class="font-display text-[clamp(1rem,0.85rem+0.6vw,1.5rem)] font-medium opacity-85">{f.label}</p>
							<h2>
								<button
									type="button"
									class="fighter-pick"
									role="radio"
									aria-checked={f.active ? 'true' : 'false'}
									aria-label={f.name}
									tabindex={f.active ? 0 : -1}
									data-pick={f.id}
								>
									<span class="fighter-name t-display block" data-name>{f.short}</span>
								</button>
							</h2>
							<p class="mt-3 max-w-[30ch] text-[1rem] leading-snug opacity-90 max-md:hidden md:inline-block lg:mt-5" data-tagline>
								{f.tagline}
							</p>
							<ul
								class="moves mt-5 flex max-w-[30rem] flex-wrap gap-x-5 gap-y-1.5 text-[0.92rem]"
								style={f.active ? '' : 'visibility:hidden'}
								data-moves
							>
								{f.moves.map((m) => (
									<li class="font-display font-medium">{m.title}</li>
								))}
							</ul>
						</div>
					</div>
				</article>
			))
		}
	</div>

	<div class="absolute inset-x-0 bottom-0 z-10 flex flex-col items-center gap-3 pb-6">
		<a href={fighters[0].href} class="btn btn-crema shadow-[0_0_0_6px_var(--color-tinta)]" data-confirm>
			<span>{copy.choose} <span data-confirm-name>{fighters[0].name}</span></span>
		</a>
		<p class="rounded-full bg-tinta px-4 py-1 text-[0.85rem] text-crema/85">
			<span class="max-md:hidden">{copy.hintDesktop}</span>
			<span class="md:hidden">{copy.hintTouch}</span>
		</p>
	</div>

	<div class="flash" data-flash></div>
</section>
