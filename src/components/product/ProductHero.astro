---
import type { Product } from '../../data/products';
import TramaAbierta from '../TramaAbierta.astro';
import Wordmark from '../Wordmark.astro';
import { GRID, circles, parseSprite } from '../../lib/dots';
import { asLang, path } from '../../i18n/routes';
import { t } from '../../i18n/ui';

interface Props {
	product: Product;
}

const { product: p } = Astro.props;
const lang = asLang(Astro.currentLocale);
const s = t(lang);
---

<section class="on-dark relative overflow-hidden bg-[var(--accent)] pt-32 text-[var(--accent-ink)] md:pt-40">
	<TramaAbierta from="right" span={11} class="top-24 max-md:hidden" />
	<div class="wrap relative grid gap-10 pb-16 md:grid-cols-12 md:pb-24">
		<div class="md:col-span-7 lg:col-span-7">
			<p class="mb-8 md:mb-10"><Wordmark sub={p.id} label={p.name} class="h-14 w-auto md:h-[4.5rem]" /></p>
			<h1 class="t-display max-w-[11ch] text-[clamp(3.25rem,1.5rem+7vw,8rem)]">{p.heading}</h1>
			<p class="t-h3 measure mt-8 max-w-[32ch]">{p.tagline}</p>
			<p class="mt-4 opacity-85">{p.audience}</p>
			<div class="mt-10 flex flex-wrap gap-3">
				<a href={`${path('contact', lang)}?interes=${p.id}`} class="btn btn-crema">{s.demo}</a>
				<a href="#modulos" class="btn btn-ghost">{s.product.seeModules}</a>
			</div>
		</div>
		<svg
			class="dots self-center opacity-95 max-md:mx-auto max-md:w-3/4 md:col-span-4 md:col-start-8"
			viewBox={`0 0 ${GRID} ${GRID}`}
			aria-hidden="true"
			set:html={circles(parseSprite(p.sprite))}
		/>
	</div>
	<nav class="border-t border-current/20" aria-label={`${s.product.modulesAria}: ${p.name}`}>
		<ul class="wrap scroll-cue flex gap-x-8 overflow-x-auto py-3 whitespace-nowrap [scrollbar-width:none]">
			{
				p.modules.map((m) => (
					<li>
						<a href={`#${m.id}`} class="inline-flex min-h-11 items-center font-display font-medium opacity-85 transition-opacity hover:opacity-100">
							{m.title}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
</section>
