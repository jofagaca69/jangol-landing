---
import ResourceList from './ResourceList.astro';
import { getRecursos } from '../lib/recursos';
import { asLang, path } from '../i18n/routes';
import { t } from '../i18n/ui';

const lang = asLang(Astro.currentLocale);
const s = t(lang).resources;
const latest = (await getRecursos(lang)).slice(0, 3);
---

{
	latest.length > 0 && (
		<section class="border-t border-tinta/10 py-24 md:py-32">
			<div class="wrap">
				<div class="flex flex-wrap items-end justify-between gap-6">
					<h2 class="t-h2 max-w-[14ch]">{s.latestTitle}</h2>
					<a href={path('resources', lang)} class="inline-flex min-h-11 items-center font-display font-semibold underline decoration-2 underline-offset-4">
						{s.seeAll}
					</a>
				</div>
				<div class="mt-12">
					<ResourceList items={latest} />
				</div>
			</div>
		</section>
	)
}
