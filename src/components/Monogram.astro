---
import { GRID, MONOGRAM, circles, parseSprite } from '../lib/dots';

interface Props {
	class?: string;
	label?: string;
}

const { class: className = '', label } = Astro.props;
const dots = parseSprite(MONOGRAM);
// Crop the viewBox to the edges of the J itself so it sits flush next to the wordmark.
const x0 = Math.min(...dots.map((d) => d.x - d.r));
const y0 = Math.min(...dots.map((d) => d.y - d.r));
const x1 = Math.max(...dots.map((d) => d.x + d.r));
const y1 = Math.max(...dots.map((d) => d.y + d.r));
const vb = `${x0.toFixed(2)} ${y0.toFixed(2)} ${(x1 - x0).toFixed(2)} ${(y1 - y0).toFixed(2)}`;
---

<svg
	class:list={['dots', className]}
	viewBox={vb}
	role={label ? 'img' : undefined}
	aria-label={label}
	aria-hidden={label ? undefined : 'true'}
	data-grid={GRID}
	set:html={circles(dots)}
/>
