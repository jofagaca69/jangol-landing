---
import Frame from './Frame.astro';
---

<div class="relative pb-4 sm:pl-32">
	<Frame title="Circulares" class="w-full">
		<p class="ui-label">Salida al Museo de Historia Natural</p>
		<p class="mt-1 text-tinta/55">Enviada a 4.º primaria A y B</p>
		<div class="ui-in mt-3">
			<div class="flex justify-between"><span>Leída</span><span class="tabular-nums">51 de 58</span></div>
			<span class="ui-meter mt-1.5" style="--v:0.88"></span>
		</div>
		<div class="ui-in mt-3" style="--i:1">
			<div class="flex justify-between"><span>Autorizada</span><span class="tabular-nums">44 de 58</span></div>
			<span class="ui-meter mt-1.5" style="--v:0.76"></span>
		</div>
		<span class="ui-btn mt-4 inline-flex">Recordar a 14 familias</span>
	</Frame>
	<Frame kind="phone" class="ui-in absolute bottom-0 left-0 w-[9.5rem] max-sm:hidden">
		<p class="text-tinta/55">Colegio · hace 2 h</p>
		<p class="mt-1 font-semibold">Salida al museo el viernes 14</p>
		<p class="mt-1 text-tinta/70">Salimos a las 9:00 y volvemos a las 13:00. Enviar lonchera.</p>
		<span class="ui-btn mt-3 flex w-full justify-center">Autorizo</span>
	</Frame>
</div>
