---
import Frame from './Frame.astro';
import { asLang } from '../../i18n/routes';

const c = {
	es: {
		title: 'Socios',
		active: 'Socios activos',
		add: 'Nuevo socio',
		rows: [
			{ name: 'Camila Rojas', plan: 'Mensual libre', until: '28 oct', state: 'ok', label: 'Al día' },
			{ name: 'Diego Fernández', plan: 'Trimestral', until: '3 nov', state: 'warn', label: 'Vence en 5 días' },
			{ name: 'Lucía Paredes', plan: '12 sesiones', until: '7 de 12', state: 'ok', label: 'Al día' },
			{ name: 'Mateo Silva', plan: 'Mensual libre', until: '14 oct', state: 'bad', label: 'Vencido' },
			{ name: 'Valentina Cruz', plan: 'Anual', until: '2 ago', state: 'pause', label: 'Congelado' },
		],
	},
	en: {
		title: 'Members',
		active: 'Active members',
		add: 'New member',
		rows: [
			{ name: 'Camila Rojas', plan: 'Monthly unlimited', until: 'Oct 28', state: 'ok', label: 'Up to date' },
			{ name: 'Diego Fernández', plan: 'Quarterly', until: 'Nov 3', state: 'warn', label: 'Ends in 5 days' },
			{ name: 'Lucía Paredes', plan: '12 sessions', until: '7 of 12', state: 'ok', label: 'Up to date' },
			{ name: 'Mateo Silva', plan: 'Monthly unlimited', until: 'Oct 14', state: 'bad', label: 'Expired' },
			{ name: 'Valentina Cruz', plan: 'Yearly', until: 'Aug 2', state: 'pause', label: 'Frozen' },
		],
	},
}[asLang(Astro.currentLocale)];
---

<Frame title={c.title}>
	<div class="flex items-center justify-between gap-3">
		<p class="ui-h">{c.active} <span class="text-tinta/55">248</span></p>
		<span class="ui-btn">{c.add}</span>
	</div>
	<ul class="mt-3 grid gap-1">
		{
			c.rows.map((r, i) => (
				<li class="ui-row ui-in grid-cols-[1.6rem_1fr_auto]" style={`--i:${i}`}>
					<span class="ui-avatar">{r.name.split(' ').map((w) => w[0]).join('')}</span>
					<span class="min-w-0">
						<span class="block truncate font-semibold">{r.name}</span>
						<span class="block truncate text-tinta/65">
							{r.plan} · {r.until}
						</span>
					</span>
					<span class:list={['ui-chip', `ui-chip-${r.state}`]}>{r.label}</span>
				</li>
			))
		}
	</ul>
</Frame>
