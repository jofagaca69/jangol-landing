---
import Frame from './Frame.astro';
import { asLang } from '../../i18n/routes';

const c = {
	es: { title: 'Clases', days: ['L', 'M', 'M', 'J', 'V', 'S'], with: 'con', waiting: 'en espera', full: 'Lleno', open: 'Hay cupo', names: ['Spinning', 'Funcional', 'Yoga', 'Cross'] },
	en: { title: 'Classes', days: ['M', 'T', 'W', 'T', 'F', 'S'], with: 'with', waiting: 'waiting', full: 'Full', open: 'Open', names: ['Spinning', 'Functional', 'Yoga', 'Cross'] },
}[asLang(Astro.currentLocale)];
const classes = [
	{ time: '07:00', name: c.names[0], coach: 'Rocío', taken: 20, cap: 20, wait: 3 },
	{ time: '08:00', name: c.names[1], coach: 'Bruno', taken: 14, cap: 18, wait: 0 },
	{ time: '18:30', name: c.names[2], coach: 'Inés', taken: 9, cap: 15, wait: 0 },
	{ time: '19:30', name: c.names[3], coach: 'Bruno', taken: 16, cap: 16, wait: 1 },
];
---

<Frame title={c.title}>
	<div class="flex gap-1">
		{c.days.map((d, i) => <span class:list={['ui-day', i === 2 && 'ui-day-on']}>{d}</span>)}
	</div>
	<ul class="mt-3 grid gap-1">
		{
			classes.map((k, i) => {
				const full = k.taken >= k.cap;
				return (
					<li class="ui-row ui-in grid-cols-[2.6rem_1fr_auto]" style={`--i:${i}`}>
						<span class="font-semibold tabular-nums">{k.time}</span>
						<span class="min-w-0">
							<span class="block truncate font-semibold">
								{k.name} <span class="font-normal text-tinta/65">{c.with} {k.coach}</span>
							</span>
							<span class="ui-meter mt-1.5" style={`--v:${k.taken / k.cap}`} />
						</span>
						<span class="text-right">
							<span class="block tabular-nums">
								{k.taken}/{k.cap}
							</span>
							{k.wait > 0 ? (
								<span class="block text-[var(--accent)]">
									{k.wait} {c.waiting}
								</span>
							) : (
								<span class="block text-tinta/65">{full ? c.full : c.open}</span>
							)}
						</span>
					</li>
				);
			})
		}
	</ul>
</Frame>
