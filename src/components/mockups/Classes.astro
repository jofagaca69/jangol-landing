---
import Frame from './Frame.astro';

const classes = [
	{ time: '07:00', name: 'Spinning', coach: 'Rocío', taken: 20, cap: 20, wait: 3 },
	{ time: '08:00', name: 'Funcional', coach: 'Bruno', taken: 14, cap: 18, wait: 0 },
	{ time: '18:30', name: 'Yoga', coach: 'Inés', taken: 9, cap: 15, wait: 0 },
	{ time: '19:30', name: 'Cross', coach: 'Bruno', taken: 16, cap: 16, wait: 1 },
];
const days = ['L', 'M', 'M', 'J', 'V', 'S'];
---

<Frame title="Clases">
	<div class="flex gap-1">
		{days.map((d, i) => <span class:list={['ui-day', i === 2 && 'ui-day-on']}>{d}</span>)}
	</div>
	<ul class="mt-3 grid gap-1">
		{
			classes.map((c, i) => {
				const full = c.taken >= c.cap;
				return (
					<li class="ui-row ui-in grid-cols-[2.6rem_1fr_auto]" style={`--i:${i}`}>
						<span class="font-semibold tabular-nums">{c.time}</span>
						<span class="min-w-0">
							<span class="block truncate font-semibold">
								{c.name} <span class="font-normal text-tinta/55">con {c.coach}</span>
							</span>
							<span class="ui-meter mt-1.5" style={`--v:${c.taken / c.cap}`} />
						</span>
						<span class="text-right">
							<span class="block tabular-nums">
								{c.taken}/{c.cap}
							</span>
							{c.wait > 0 ? (
								<span class="block text-[var(--accent)]">{c.wait} en espera</span>
							) : (
								<span class="block text-tinta/55">{full ? 'Lleno' : 'Hay cupo'}</span>
							)}
						</span>
					</li>
				);
			})
		}
	</ul>
</Frame>
