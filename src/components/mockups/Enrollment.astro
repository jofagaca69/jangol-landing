---
import Frame from './Frame.astro';
import { asLang } from '../../i18n/routes';

const c = {
	es: {
		head: 'Matrícula 2027 · Grado 3.°',
		steps: ['Estudiante', 'Familia', 'Documentos', 'Pago'],
		docs: ['Registro civil', 'Tarjeta de identidad', 'Boletín del año anterior', 'Carné de vacunas'],
		step: 'Paso 3 de 4: documentos',
		upload: 'Subir carné de vacunas',
	},
	en: {
		head: 'Enrollment 2027 · Grade 3',
		steps: ['Student', 'Family', 'Documents', 'Payment'],
		docs: ['Birth certificate', 'ID card', "Last year's report card", 'Vaccination card'],
		step: 'Step 3 of 4: documents',
		upload: 'Upload vaccination card',
	},
}[asLang(Astro.currentLocale)];
const docs = c.docs.map((name, i) => ({ name, done: i < 3 }));
---

<div class="mx-auto w-[15.5rem]">
	<Frame kind="phone">
		<p class="text-tinta/65">{c.head}</p>
		<p class="ui-h mt-0.5">Sofía Mendoza</p>
		<ol class="mt-3 flex gap-1" aria-hidden="true">
			{c.steps.map((s, i) => <li class:list={['ui-step', i < 2 && 'ui-step-done', i === 2 && 'ui-step-on']} title={s} />)}
		</ol>
		<p class="mt-1.5 font-semibold">{c.step}</p>
		<ul class="mt-3 grid gap-1">
			{
				docs.map((d, i) => (
					<li class="ui-row ui-in grid-cols-[1rem_1fr]" style={`--i:${i}`}>
						<span class:list={['ui-check', d.done && 'ui-check-on']} />
						<span class:list={['truncate', !d.done && 'text-tinta/65']}>{d.name}</span>
					</li>
				))
			}
		</ul>
		<span class="ui-btn mt-4 flex w-full justify-center">{c.upload}</span>
	</Frame>
</div>
