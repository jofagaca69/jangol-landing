---
import Frame from './Frame.astro';
import { asLang } from '../../i18n/routes';

const c = {
	es: {
		title: 'Estado de cuenta',
		sub: 'Grado 3.° · Descuento por hermanos 10%',
		months: ['febrero', 'marzo', 'abril', 'mayo', 'junio'],
		item: (m: string) => `Pensión de ${m}`,
		labels: { ok: 'Pagada', warn: 'Vence el 30', idle: 'Por emitir' },
		due: 'Por pagar este mes',
		amount: '$ 485.000',
		pay: 'Pagar con PSE',
	},
	en: {
		title: 'Account statement',
		sub: 'Grade 3 · Sibling discount 10%',
		months: ['February', 'March', 'April', 'May', 'June'],
		item: (m: string) => `${m} tuition`,
		labels: { ok: 'Paid', warn: 'Due on the 30th', idle: 'Not issued yet' },
		due: 'Due this month',
		amount: 'COP 485,000',
		pay: 'Pay with PSE',
	},
}[asLang(Astro.currentLocale)];
const states = ['ok', 'ok', 'ok', 'warn', 'idle'] as const;
---

<Frame title={c.title}>
	<div class="flex items-end justify-between gap-3">
		<span>
			<span class="ui-h block">Sofía Mendoza</span>
			<span class="block text-tinta/65">{c.sub}</span>
		</span>
	</div>
	<ul class="mt-3 grid gap-1">
		{
			c.months.map((m, i) => (
				<li class="ui-row ui-in grid-cols-[1fr_auto_auto]" style={`--i:${i}`}>
					<span class="font-semibold">{c.item(m)}</span>
					<span class="tabular-nums">{c.amount}</span>
					<span class:list={['ui-chip', `ui-chip-${states[i]}`]}>{c.labels[states[i]]}</span>
				</li>
			))
		}
	</ul>
	<div class="mt-3 flex items-center justify-between gap-3 rounded-xl bg-tinta/5 px-3 py-2.5">
		<span>
			{c.due} <strong class="font-semibold tabular-nums">{c.amount}</strong>
		</span>
		<span class="ui-btn">{c.pay}</span>
	</div>
</Frame>
