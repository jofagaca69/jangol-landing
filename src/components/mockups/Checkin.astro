---
import Frame from './Frame.astro';
import { circles, qrDots } from '../../lib/dots';

const log = [
	{ name: 'Camila Rojas', time: '07:02', ok: true },
	{ name: 'Andrés Vega', time: '06:58', ok: true },
	{ name: 'Mateo Silva', time: '06:55', ok: false },
];
---

<div class="relative pb-6 sm:pr-32">
	<Frame title="Recepción · Sede Centro" class="w-full">
		<div class="ui-in ui-pop flex items-center gap-3 rounded-xl bg-[var(--accent)] p-3 text-[var(--accent-ink)]">
			<span class="grid size-8 shrink-0 place-items-center rounded-full bg-[var(--accent-ink)] text-[var(--accent)]">
				<svg viewBox="0 0 16 16" class="size-4" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" /></svg>
			</span>
			<span>
				<span class="block font-semibold">Acceso permitido</span>
				<span class="block opacity-80">Camila Rojas · Mensual libre hasta el 28 oct</span>
			</span>
		</div>
		<p class="ui-label mt-4">Últimas entradas</p>
		<ul class="mt-1.5 grid gap-1">
			{
				log.map((l, i) => (
					<li class="ui-row ui-in grid-cols-[1fr_auto_auto]" style={`--i:${i + 1}`}>
						<span class="truncate font-semibold">{l.name}</span>
						<span class="text-tinta/55">{l.time}</span>
						<span class:list={['ui-chip', l.ok ? 'ui-chip-ok' : 'ui-chip-bad']}>{l.ok ? 'Entró' : 'Plan vencido'}</span>
					</li>
				))
			}
		</ul>
	</Frame>
	<Frame kind="phone" class="ui-in absolute right-0 bottom-0 w-[9rem] max-sm:hidden">
		<p class="text-center font-semibold">Tu código</p>
		<svg class="dots ui-qr mt-2 text-tinta" viewBox="0 0 21 21" aria-hidden="true" set:html={circles(qrDots(3))} />
		<p class="mt-2 text-center text-tinta/55">Muéstralo en recepción</p>
	</Frame>
</div>
