---
import Frame from './Frame.astro';
import { asLang } from '../../i18n/routes';

const c = {
	es: { title: 'Asistencia', head: 'Visitas por semana, últimas 8', risk: 'Dejó de venir', steady: 'Constante', cta: 'Escribir a 2 socios' },
	en: { title: 'Attendance', head: 'Visits per week, last 8', risk: 'Stopped coming', steady: 'Steady', cta: 'Message 2 members' },
}[asLang(Astro.currentLocale)];

// Visits per week over the last eight weeks.
const members = [
	{ name: 'Camila Rojas', weeks: [4, 4, 3, 4, 4, 3, 4, 4], risk: false },
	{ name: 'Andrés Vega', weeks: [3, 4, 3, 3, 2, 1, 1, 0], risk: true },
	{ name: 'Lucía Paredes', weeks: [2, 2, 2, 1, 2, 2, 2, 2], risk: false },
	{ name: 'Mateo Silva', weeks: [5, 4, 5, 3, 2, 1, 0, 0], risk: true },
];
---

<Frame title={c.title}>
	<p class="ui-h">{c.head}</p>
	<ul class="mt-3 grid gap-1">
		{
			members.map((m, i) => (
				<li class:list={['ui-row ui-in grid-cols-[minmax(0,1fr)_auto]', m.risk && 'ui-row-flag']} style={`--i:${i}`}>
					<span class="min-w-0">
						<span class="block truncate font-semibold">{m.name}</span>
						<span class:list={['block truncate', m.risk ? 'text-[var(--accent)]' : 'text-tinta/65']}>{m.risk ? c.risk : c.steady}</span>
					</span>
					<svg class="ui-spark" viewBox="0 0 8 5" aria-hidden="true">
						{m.weeks.map((w, x) =>
							Array.from({ length: 5 }, (_, y) => <circle cx={x + 0.5} cy={4.5 - y} r="0.34" class={y < w ? 'on' : 'off'} />),
						)}
					</svg>
				</li>
			))
		}
	</ul>
	<span class="ui-btn mt-3 inline-flex">{c.cta}</span>
</Frame>
