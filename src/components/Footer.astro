---
import Monogram from './Monogram.astro';
import { products } from '../data/products';
import { company, isSet, whatsappUrl } from '../data/company';
import { asLang, path } from '../i18n/routes';
import { t } from '../i18n/ui';

const lang = asLang(Astro.currentLocale);
const s = t(lang).footer;
const columns = [
	{ title: s.platforms, links: products[lang].map((p) => ({ href: p.href, label: p.name })) },
	{
		title: s.services,
		links: [
			{ href: path('marketing', lang), label: s.marketing },
				{ href: path('custom', lang), label: s.customSoftware },
			{ href: `${path('custom', lang)}#proceso`, label: s.process },
			{ href: path('resources', lang), label: s.guides },
		],
	},
	{
		title: s.company,
		links: [
			{ href: path('about', lang), label: s.aboutUs },
			{ href: path('privacy', lang), label: s.privacy },
			{ href: path('terms', lang), label: s.terms },
		],
	},
	{
		title: s.contact,
		links: [
			{ href: path('contact', lang), label: t(lang).demo },
			{ href: `mailto:${company.email}`, label: company.email },
			...(whatsappUrl ? [{ href: whatsappUrl, label: 'WhatsApp' }] : []),
		],
	},
];
const legal = [company.legalName, `${s.nit} ${company.nit}`, [company.city, company.country].filter(isSet).join(', ')];
---

<footer class="on-dark bg-tinta pt-20 pb-10 text-crema/75">
	<div class="wrap">
		<div class="grid gap-12 border-b border-crema/10 pb-14 md:grid-cols-12">
			<div class="md:col-span-4">
				<a href={path('home', lang)} class="inline-flex items-center gap-2.5 py-1 text-crema" aria-label={t(lang).homeAria}>
					<Monogram class="h-8 w-auto" />
					<span class="font-display text-[1.6rem] leading-none font-bold tracking-[-0.04em]">Jangol</span>
				</a>
				<p class="mt-5 max-w-[32ch]">{t(lang).slogan}. {s.about}</p>
			</div>
			<div class="grid grid-cols-2 gap-10 sm:grid-cols-4 md:col-span-8">
				{
					columns.map((c) => (
						<div>
							<p class="font-display font-semibold text-crema">{c.title}</p>
							<ul class="mt-3 grid gap-0.5 text-[0.95rem]">
								{c.links.map((l) => (
									<li>
										<a href={l.href} class="inline-flex min-h-11 items-center break-all transition-colors hover:text-crema">
											{l.label}
										</a>
									</li>
								))}
							</ul>
						</div>
					))
				}
			</div>
		</div>
		<div class="mt-8 flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 text-[0.9rem]">
			<p>© {new Date().getFullYear()} Jangol</p>
			<p><span class="sr-only">{s.legal}: </span>{legal.filter(Boolean).join(' · ')}</p>
		</div>
	</div>
</footer>
